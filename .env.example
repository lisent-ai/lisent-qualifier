# ============================================================
# ai-lead-qualifier — Environment Variables
# ============================================================
# Production: set these via Dokploy UI (not a .env file).
# Local dev:  cp .env.example .env  and fill in the blanks.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# Dev: DB_PASSWORD is used by docker-compose.dev.yml to build DATABASE_URL.
# Prod: set DATABASE_URL directly in Dokploy to the internal pg DNS.
DB_PASSWORD=qualifierpass
DATABASE_URL=postgresql://app:qualifierpass@qualifier-db:5432/lead_qualifier

# --- Redis ---
REDIS_DSN=redis://qualifier-redis:6379/0
SESSION_TTL_SECONDS=86400

# --- Groq (cloud LLM, chat path) ---
GROQ_API_KEY=                                # REQUIRED in prod
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=5
GROQ_MAX_TOKENS=4096

# --- Local LLM (llama.cpp native on host) ---
LOCAL_LLM_URL=http://host.docker.internal:8080
LOCAL_LLM_MODEL=qwen3.5-9b
LOCAL_LLM_TIMEOUT_CHAMP=60
LOCAL_LLM_TIMEOUT_REASONING=45

# --- CRM Service (internal REST) ---
# In Dokploy prod, use the internal DNS name, e.g.
#   http://crm-service-<hash>:9090
CRM_BASE_URL=                                # REQUIRED in prod
CRM_API_KEY=                                 # REQUIRED, must match CRM API_KEY

# --- CRM Webhook (lead handoff out) ---
CRM_WEBHOOK_URL=                             # external CRM webhook if any
CRM_WEBHOOK_TOKEN=
CRM_WEBHOOK_TIMEOUT=10

# --- Internal API + WhatsApp ---
INTERNAL_API_KEY=                            # REQUIRED for /internal/leads/* auth
WHATSAPP_WEBHOOK_TOKEN=                      # REQUIRED if WhatsApp enabled
GREENAPI_BASE_URL=https://api.green-api.com
GREENAPI_REPLY_TIMEOUT=8
WHATSAPP_QUALIFIED_MESSAGE=Teşekkürler! Uzman ekibimiz en kısa sürede sizinle iletişime geçecek.

# --- Scoring ---
HIGH_THRESHOLD=80
CHAMP_EXTRACT_EVERY_N_MESSAGES=3

# --- Qualification Judge (borderline scoring via Groq) ---
QUALIFICATION_JUDGE_MODEL=llama-3.3-70b-versatile

# --- Feature flags ---
QUALIFIER_CRM_WRITETHROUGH_ENABLED=true
QUALIFIER_LEGACY_API_ENABLED=true
RAG_WEBHOOK_ENABLED=false

# --- CTA routing (dual CTA: Calendly for medium band, Cyprus visit for high) ---
# Used when company_ai_config does not set its own cta_calendly_url.
DEFAULT_CALENDLY_URL=https://calendly.com/redif
CTA_MEDIUM_FLOOR=50
