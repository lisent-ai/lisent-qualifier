# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Scoring
HIGH_THRESHOLD=80
BANT_EXTRACT_EVERY_N_MESSAGES=3

# Redis
REDIS_DSN=redis://redis:6379/0
SESSION_TTL_SECONDS=86400

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=5
GROQ_MAX_TOKENS=2048

# Local LLM (llama.cpp native on host)
LOCAL_LLM_URL=http://host.docker.internal:8080
LOCAL_LLM_TIMEOUT_BANT=60
LOCAL_LLM_TIMEOUT_REASONING=45

# CRM Webhook (lead handoff)
CRM_WEBHOOK_URL=https://your-crm.example.com/api/leads/inbound
CRM_WEBHOOK_TOKEN=your_crm_token_here
CRM_WEBHOOK_TIMEOUT=10

# CRM REST API (WhatsApp kanalı - customer/lead oluşturma)
CRM_BASE_URL=http://crm-service:9090
CRM_API_KEY=your_internal_api_key_here

# GreenAPI / WhatsApp
GREENAPI_BASE_URL=https://api.green-api.com
GREENAPI_REPLY_TIMEOUT=8
WHATSAPP_WEBHOOK_TOKEN=your_secure_webhook_token_here
WHATSAPP_QUALIFIED_MESSAGE=Teşekkürler! Uzman ekibimiz en kısa sürede sizinle iletişime geçecek.
